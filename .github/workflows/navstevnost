name: Návštěvnost

on:
  schedule:
    - cron: "15 5 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  stats:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Stažení statistik z GoatCounter
        run: python3 fetch_stats.py
        env:
          GOATCOUNTER_TOKEN: ${{ secrets.GOATCOUNTER_TOKEN }}

      - name: Commit
        run: |
          git config user.name "actions-user"
          git config user.email "actions@github.com"
          git add -A navstevnost
          if ! git diff --cached --quiet; then
            git commit -m "Návštěvnost: aktualizace"
            git pull --rebase origin main && git push
          fi
